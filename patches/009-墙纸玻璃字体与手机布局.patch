+/* 正文阅读字体:墙纸面板选了本机字体时由 deskTheme.tsx 设 --font-reading-user;没设就用后面的回落 */
 /* ── base ── */
 html {
   background: var(--page-bg);
@@ -81,3 +191,70 @@ body {
 
 /* ── 气泡断词：长英文/URL 允许在任意处折行，不撑破气泡 ── */
 .wrap-hard { overflow-wrap: break-word; overflow-wrap: anywhere; }
+
+/* ════════════════════════════════════════════════════════════
+   液态玻璃(开关在墙纸面板,开了 html 上挂 data-glass="1")。
+   只上在浮着的那几片东西上:写作窗的头栏和输入区、手机底栏、你的那楼气泡、列表页的卡片、
+   ⋯ 菜单;正文不上,不然滑动掉帧。底色铺几团同系的色斑,玻璃才有东西可折。
+   浮起来的做法:头栏/底栏脱离文档流盖在滚动区上,滚动区按顶槽/底槽量出来的高度留边
+   (--desk-top-h / --desk-bottom-h 由 TypingDesk 量,见那边 ResizeObserver)。
+   ════════════════════════════════════════════════════════════ */
+html[data-glass="1"] .sty-stage-scroll {
+  background:
+    radial-gradient(60% 38% at 12% 6%, color-mix(in srgb, var(--scale-2) 55%, transparent), transparent 72%),
+    radial-gradient(48% 30% at 88% 28%, color-mix(in srgb, var(--scale-1) 85%, transparent), transparent 72%),
+    radial-gradient(70% 45% at 45% 95%, color-mix(in srgb, var(--scale-2) 40%, transparent), transparent 72%),
+    var(--page-bg);
+  background-attachment: fixed;
+}
+html[data-glass="1"] .glass,
+html[data-glass="1"] .desk-header,
+html[data-glass="1"] .chat-inputbar,
+html[data-glass="1"] .desk-menu {
+  background: var(--g-fill) !important;
+  border: 1px solid var(--g-rim) !important;
+  backdrop-filter: blur(24px) saturate(180%);
+  -webkit-backdrop-filter: blur(24px) saturate(180%);
+  box-shadow: 0 10px 30px var(--g-shadow), inset 0 1px 0 var(--g-hi), inset 0 -1px 0 rgba(255, 255, 255, 0.15) !important;
+}
+html[data-glass="1"] .desk-header { border-radius: 24px !important; }
+html[data-glass="1"] .chat-inputbar { border-radius: 26px !important; }
+html[data-glass="1"] .desk-pill,
+html[data-glass="1"] .desk-header .pill,
+html[data-glass="1"] .chat-inputbar textarea {
+  background: var(--g-fill2) !important;
+  border: 1px solid var(--g-rim) !important;
+  box-shadow: inset 0 1px 0 var(--g-hi) !important;
+}
+html[data-glass="1"] .chat-inputbar .desk-send {
+  box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 45%, transparent), inset 0 1px 0 rgba(255, 255, 255, 0.45) !important;
+}
+html[data-glass="1"] .floor-user {
+  background: color-mix(in srgb, var(--scale-1) 55%, transparent) !important;
+  border: 1px solid var(--g-rim);
+  backdrop-filter: blur(14px) saturate(160%);
+  -webkit-backdrop-filter: blur(14px) saturate(160%);
+  box-shadow: inset 0 1px 0 var(--g-hi), 0 4px 14px var(--g-shadow);
+}
+html[data-glass="1"] .card {
+  background: var(--g-card) !important;
+  border: 1px solid var(--g-rim) !important;
+  backdrop-filter: blur(18px) saturate(170%);
+  -webkit-backdrop-filter: blur(18px) saturate(170%);
+  box-shadow: 0 8px 26px var(--g-shadow), inset 0 1px 0 var(--g-hi) !important;
+}
+/* 写作窗:头栏、底栏浮在滚动区上,滚动区按量出来的高度留边 */
+html[data-glass="1"] .sty-main.desk-writing .sty-stage-top {
+  position: absolute; top: 0; left: 0; right: 0; z-index: 8; pointer-events: none;
+  /* 刘海让位留在玻璃片外面(头栏自己不再加 --safe-top 内边距) */
+  padding: calc(10px + var(--safe-top, env(safe-area-inset-top, 0px))) 10px 0;
+}
+html[data-glass="1"] .sty-main.desk-writing .desk-header { padding-top: 12px !important; }
+html[data-glass="1"] .sty-main.desk-writing .sty-stage-top > * { pointer-events: auto; }
+html[data-glass="1"] .sty-main.desk-writing .sty-stage-bottom {
+  position: absolute; bottom: 0; left: 0; right: 0; z-index: 2; padding: 0 10px 12px;
+}
+html[data-glass="1"] .sty-main.desk-writing .sty-stage-scroll {
+  padding-top: var(--desk-top-h, 0px);
+  padding-bottom: var(--desk-bottom-h, 0px);
+}
