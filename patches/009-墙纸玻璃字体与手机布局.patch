+/* ════════════════════════════════════════════════════════════
+   墙纸:每套就是一组变量值,挂在 html[data-theme]。纸绿(sage)是上面 :root 的默认。
+   选哪套、跟不跟系统,见 study/deskTheme.tsx;layout.tsx 里有一段开机脚本先把存的选择
+   写到 html 上,免得首屏闪一下白。
+   ════════════════════════════════════════════════════════════ */
+html[data-theme="ink"] {
+  /* 墨夜:深青灰底、米白字、同一系的绿做强调 */
+  --scale-0: #26301f;
+  --scale-1: #33432a;
+  --scale-2: #4f6b3a;
+  --scale-3: #6f9e4a;
+  --scale-4: #a3c98a;
+  --page-bg: #1b1f1a;
+  --card-bg: #242a22;
+  --ink-deep: #e6ead9;
+  --ink-body: #c9cfbc;
+  --ink2: #7f8a72;
+  --line-soft: #30372c;
+  --dash-line: #3d4737;
+  --accent: #8fb86b;
+  --card-shadow: rgba(0, 0, 0, 0.35);
+  --card-shadow2: rgba(0, 0, 0, 0.5);
+  --glass-bg: rgba(36, 42, 34, 0.8);
+  --heatbg-0: #222a1f;
+  --heatbg-1: #283322;
+  --heatbg-2: #33432a;
+  --heatbg-3: #4f6b3a;
+  --scrim-rgb: 27, 31, 26;
+  --warn: #d98b6a;
+  --on-accent: #16200f;
+  --g-fill: rgba(255, 255, 255, 0.07);
+  --g-fill2: rgba(255, 255, 255, 0.11);
+  --g-rim: rgba(255, 255, 255, 0.16);
+  --g-hi: rgba(255, 255, 255, 0.22);
+  --g-shadow: rgba(0, 0, 0, 0.45);
+  --g-card: rgba(255, 255, 255, 0.08);
+  color-scheme: dark;
+}
+html[data-theme="rice"] {
+  /* 米纸:暖米底、褐字、琥珀强调 */
+  --scale-0: #f0e8d8;
+  --scale-1: #e2d2b2;
+  --scale-2: #cdb27f;
+  --scale-3: #b0823f;
+  --scale-4: #7a5828;
+  --page-bg: #f7f3ea;
+  --card-bg: #fffdf7;
+  --ink-deep: #4a3f32;
+  --ink-body: #5c5245;
+  --ink2: #a4998a;
+  --line-soft: #ece5d8;
+  --dash-line: #dccfb8;
+  --accent: #b0823f;
+  --card-shadow: rgba(95, 80, 55, 0.10);
+  --card-shadow2: rgba(95, 80, 55, 0.16);
+  --glass-bg: rgba(255, 253, 247, 0.8);
+  --heatbg-0: #efe8da;
+  --heatbg-1: #ebe2d0;
+  --heatbg-2: #e2d2b2;
+  --heatbg-3: #cdb27f;
+  --scrim-rgb: 247, 243, 234;
+  --warn: #b85c3a;
+  --on-accent: #fffaf0;
+  --g-shadow: rgba(95, 80, 55, 0.16);
+}
+html[data-theme="bronze"] {
+  /* 乌金:暖黑底、米字、铜金强调 */
+  --scale-0: #2b2620;
+  --scale-1: #3d3429;
+  --scale-2: #6b5538;
+  --scale-3: #a3783f;
+  --scale-4: #d0a36a;
+  --page-bg: #1e1b18;
+  --card-bg: #272320;
+  --ink-deep: #ece4d6;
+  --ink-body: #cfc5b4;
+  --ink2: #8a7f70;
+  --line-soft: #35302a;
+  --dash-line: #46403a;
+  --accent: #c9955a;
+  --card-shadow: rgba(0, 0, 0, 0.35);
+  --card-shadow2: rgba(0, 0, 0, 0.5);
+  --glass-bg: rgba(39, 35, 32, 0.8);
+  --heatbg-0: #262220;
+  --heatbg-1: #2c2723;
+  --heatbg-2: #3d3429;
+  --heatbg-3: #6b5538;
+  --scrim-rgb: 30, 27, 24;
+  --warn: #e0906a;
+  --on-accent: #1f1710;
+  --g-fill: rgba(255, 255, 255, 0.07);
+  --g-fill2: rgba(255, 255, 255, 0.11);
+  --g-rim: rgba(255, 255, 255, 0.16);
