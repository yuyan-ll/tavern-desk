From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 19:06:59 +0000
Subject: [PATCH] frontend: 输入框左边加「桌边」钮,亮着时说的话是桌边话
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

为什么:她要在纸条旁边有一颗钮,点了说的就是桌边话,不用每句手打「桌边：」。
- TypingDesk.tsx:纸条旁边加「桌边」钮,点一下亮、再点一下灭,亮着时输入框提示改成「桌边说话…」;
  发送时替她在正文前面安上「桌边：」(已经是桌边话开头的不重复安,判据同 src/core/deskAside.ts),
  后端照旧按前缀认、存楼记 aside。重发孤儿楼(overrideMsg)原文不动。还给输入框、跟输入框比对的
  一律是她打的原话,落楼和发给后端的才带前缀。亮灭按窗记在本机 localStorage['oc_desk_aside_<窗>']。
  手机上第一行三颗小钮,mr-auto 从纸条挪到桌边。
- globals.css:玻璃模式把 .desk-pill 底色一律盖成玻璃,按下的小钮(aria-pressed)另铺强调色,
  不然亮着也看不出来。
---
 frontend/app/globals.css          |  6 +++++
 frontend/app/study/TypingDesk.tsx | 43 +++++++++++++++++++++++++------
 2 files changed, 41 insertions(+), 8 deletions(-)

diff --git a/frontend/app/globals.css b/frontend/app/globals.css
index e226c9d..4fe4dcd 100644
--- a/frontend/app/globals.css
+++ b/frontend/app/globals.css
@@ -238,6 +238,12 @@ html[data-glass="1"] .chat-inputbar textarea {
   border: 1px solid var(--g-rim) !important;
   box-shadow: inset 0 1px 0 var(--g-hi) !important;
 }
+/* 按下的小钮(桌边钮亮着)玻璃模式下也得看得出来:上面那条把 .desk-pill 的底色一律盖成玻璃 */
+html[data-glass="1"] .desk-pill[aria-pressed="true"] {
+  background: var(--accent) !important;
+  border-color: var(--accent) !important;
+  color: #fff;
+}
 html[data-glass="1"] .chat-inputbar .desk-send {
   box-shadow: 0 3px 12px color-mix(in srgb, var(--accent) 40%, transparent), inset 0 1px 0 rgba(255, 255, 255, 0.45) !important;
 }
diff --git a/frontend/app/study/TypingDesk.tsx b/frontend/app/study/TypingDesk.tsx
index 42487af..36ea963 100644
--- a/frontend/app/study/TypingDesk.tsx
+++ b/frontend/app/study/TypingDesk.tsx
@@ -399,6 +399,9 @@ function chunkStreamText(s: string): string[] {
 // 折起来之后紧跟的几个空行也一并吞掉,不再在折叠签下面留一大截空白。
 // 跟上面分块的约定兼容:段的边界只取决于前缀里有没有出现空行,流式追加不会挪已有边界,
 // 每段内部再走 chunkStreamText,前面段的文本节点原样不动,选区活得下来。
+// 桌边话判据,跟后端 src/core/deskAside.ts 同一条:「桌边」开头,后面是结尾/空白/冒号/逗号。
+const DESK_ASIDE_RE = /^桌边(?:$|[\s:：,，])/;
+
 function splitParagraphs(s: string): string[] {
   return s.replace(/^\n+/, '').replace(/\n+$/, '').split(/\n{2,}/).filter((p) => p.length > 0);
 }
